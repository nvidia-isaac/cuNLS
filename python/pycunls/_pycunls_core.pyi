class SparseLinearSolverType(enum.Enum):
    """
    Solver of the assembled system (MinimizerOptions.sparse_linear_solver_type; not used with LinearSystemType.SchurComplement). Default: BlockSparseCholesky.
    """

    cuDSS = 0
    """
    NVIDIA cuDSS sparse direct solver (optional dependency, loaded at run time).
    """

    DenseLDLT = 1
    """Dense pivoted LDLT (small systems)."""

    DenseCholesky = 2
    """Dense cuSOLVER Cholesky (small SPD systems)."""

    DenseQR = 3
    """Dense cuSOLVER QR (small non-singular systems)."""

    BlockSparsePCG = 4
    """
    Block-Jacobi preconditioned conjugate gradient (inexact steps); for graphs with many long-range random edges.
    """

    BlockTridiagonal = 5
    """
    Block-tridiagonal Cholesky of stage-ordered problems (Problem.set_state_stages).
    """

    BlockSparseCholesky = 6
    """
    Supernodal sparse Cholesky on the GPU (default; exact steps, no dependencies).
    """

class StateBatch:
    """Abstract base class for batched states on a manifold."""

    @property
    def capacity(self) -> int:
        """States the state buffer holds (the constructor's capacity)."""

    @property
    def const_capacity(self) -> int:
        """
        Entries the constant-id buffer holds (the constructor's const_capacity).
        """

    @property
    def num_const_states(self) -> int:
        """
        Active constant-id count: the first num_const_states entries of the constant-id buffer are held constant (0 until set_num_active_states).
        """

    def set_num_active_states(self, num_active_states: int, num_const_states: int = 0) -> None:
        """
        Sets the active state count (the first num_active_states states of the buffer) and the active constant-id count (num_const_states). Batches start with 0 active states: call this before the first solve, and again whenever the sizes change. Host-only; takes effect at the next minimize(). Raises ValueError above the capacity.
        """

    @property
    def num_active_states(self) -> int:
        """Active state count (set_num_active_states)."""

    @property
    def tangent_size(self) -> int:
        """Degrees of freedom of one state (size of its update)."""

    @property
    def ambient_size(self) -> int:
        """float32 values stored per state (e.g. 16 for SE3: a row-major 4x4)."""

    def state_device_ptr(self, index: int) -> int:
        """Device address of state `index` (an int)."""

    def constant_state_ids(self) -> Annotated[ArrayLike, dict(dtype='int32', shape=(None))]:
        """
        The active constant state ids (num_const_states entries) as a numpy int32 array.
        """

    def apply_plus(self, x: object, delta: object, out: object, stream: CudaStream) -> None:
        """
        out = x (+) delta for the num_active_states states of the given arrays (the manifold update the minimizers use; asynchronous on stream). x, out: float32 device arrays of num_active_states x ambient_size; delta: num_active_states x tangent_size. Used by pycunls.check_jacobians.
        """

