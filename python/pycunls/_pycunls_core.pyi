class Verbosity(enum.IntEnum):
    """Log levels, from least to most verbose."""

    Silent = 0
    """Nothing is logged."""

    Error = 1
    """Errors only (they are also raised)."""

    Warning = 2
    """Errors and warnings (e.g. a failed linear solve that was rejected)."""

    Message = 3
    """
    Also one line per minimizer iteration and the final termination message.
    """

    Debug = 4
    """Everything, including internal details."""

class WeightedFactorBatch(FactorBatch):
    """
    Wraps any factor batch and scales residuals/Jacobians by a weight.

    Supports two modes:
      1. Uniform weight (float): every factor is scaled equally.
      2. Per-factor weights (DevicePointer): each factor gets its own weight.

    Parameters
    ----------
    inner_factor : FactorBatch
        The factor batch to wrap.
    weight : float, optional
        Uniform scalar weight applied to all factors.
    weights : DevicePointer, optional, keyword-only
        Device buffer with ``inner_factor.capacity`` floats (one per factor).

    Exactly one of ``weight`` or ``weights`` must be provided.

    WeightedFactorBatch (factor)
      residual: w * r_inner
      weights: optional 1 float per factor
      relative: no
      use: Scale any factor by a weight (1 / sigma).
      notes: Inherits the wrapped factor's states.
      capacity: how many factors (or states) the arrays hold. Batches start with 0 active items: call set_num_active_factors(n) / set_num_active_states(n) before solving. Arrays are float32 GPU arrays (CuPy), C-contiguous.
    """

    @overload
    def __init__(self, inner_factor: FactorBatch, weight: float) -> None: ...

    @overload
    def __init__(self, inner_factor: FactorBatch, *, weights: object) -> None: ...

    @property
    def inner_factor(self) -> FactorBatch:
        """The wrapped factor batch."""

def set_log_verbosity(verbosity: Verbosity) -> None:
    """
    Sets the library log level. The default is Silent, or the level named by the environment variable CUNLS_LOG_LEVEL (silent, error, warning, message, debug). Message logs every minimizer iteration and why the solve stopped.
    """
