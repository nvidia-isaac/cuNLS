class ImuFactorBatch(FactorBatch):
    """
    IMU factor between two keyframes; the raw samples between them define a chain of Euler steps whose intermediate states are marginalized inside the factor (Schur complement, recomputed every evaluation). States: T_a (SE3StateBatch, world_from_rig as in ReprojectionFactorBatch / PnPFactorBatch), v_a (VectorStateBatch3, world velocity of the IMU), b_a = [b_g; b_a] (VectorStateBatch6), T_b, v_b, b_b. Residual (15): the whitened defect of keyframe b against the prediction (9) and the bias random walk (6). Analytic Jacobians.

    Parameters
    ----------
    imu_samples : DevicePointer
        float32, 7 per sample (gyro xyz [rad/s], specific force xyz [m/s^2], dt [s]), IMU frame, all factors back to back.
    sample_offsets : DevicePointer
        int32, capacity + 1 CSR offsets: factor f uses samples [offsets[f], offsets[f + 1]) (at least one).
    num_samples : int
        Number of samples imu_samples holds; only sizes the work split (num_samples / capacity is taken as the typical chain length).
    parameters : ImuParameters
    capacity : int
        Number of factors (keyframe pairs) the buffers hold.

    ImuFactorBatch (factor)
      states: [SE3StateBatch, VectorStateBatch3, VectorStateBatch6, SE3StateBatch, VectorStateBatch3, VectorStateBatch6]
      residual (15): preintegrated IMU error between two keyframes (pose, velocity, biases)
      imu_samples: raw samples, see docs/sphinx/imu.rst
      sample_offsets: int32 per factor
      relative: yes (needs an anchor: a constant state or a prior)
      use: Visual-inertial estimation; guide docs/sphinx/imu.rst.
      notes: Gravity makes roll and pitch observable; yaw and position still need an anchor.
      capacity: how many factors (or states) the arrays hold. Batches start with 0 active items: call set_num_active_factors(n) / set_num_active_states(n) before solving. Arrays are float32 GPU arrays (CuPy), C-contiguous.
    """

    def __init__(self, imu_samples: object, sample_offsets: object, num_samples: int, parameters: ImuParameters, capacity: int) -> None: ...

class ImuParameters:
    """
    Sensor model of ImuFactorBatch. Noise densities are continuous-time (defaults: the ADIS16448 of the EuRoC MAV dataset); gravity defaults to (0, 0, -9.80665), +Z up; body_from_imu is the row-major 4x4 pose of the IMU in the body (rig) frame, rig_from_imu (identity).
    """

    def __init__(self) -> None: ...

    @property
    def gravity(self) -> list[float]:
        """World-frame gravity [m/s^2]."""

    @gravity.setter
    def gravity(self, arg: Sequence[float], /) -> None: ...

    @property
    def gyro_noise_density(self) -> float:
        """Gyroscope white noise sigma_g [rad/s/sqrt(Hz)]."""

    @gyro_noise_density.setter
    def gyro_noise_density(self, arg: float, /) -> None: ...

    @property
    def accel_noise_density(self) -> float:
        """Accelerometer white noise sigma_a [m/s^2/sqrt(Hz)]."""

    @accel_noise_density.setter
    def accel_noise_density(self, arg: float, /) -> None: ...

    @property
    def integration_noise_density(self) -> float:
        """
        Position noise of the Euler step sigma_i [m/sqrt(s)] (as GTSAM's integration covariance); must be positive.
        """

    @integration_noise_density.setter
    def integration_noise_density(self, arg: float, /) -> None: ...

    @property
    def gyro_bias_random_walk(self) -> float:
        """
        Gyroscope bias random walk sigma_bg [rad/s^2/sqrt(Hz)]. Very small values make the bias rows stiff; loosen (about 1e-2) if Levenberg-Marquardt stalls.
        """

    @gyro_bias_random_walk.setter
    def gyro_bias_random_walk(self, arg: float, /) -> None: ...

    @property
    def accel_bias_random_walk(self) -> float:
        """
        Accelerometer bias random walk sigma_ba [m/s^3/sqrt(Hz)]. Loosen (about 1e-1) if Levenberg-Marquardt stalls.
        """

    @accel_bias_random_walk.setter
    def accel_bias_random_walk(self, arg: float, /) -> None: ...

    @property
    def body_from_imu(self) -> list[float]:
        """Pose of the IMU in the body frame, row-major 4x4 (16 floats)."""

    @body_from_imu.setter
    def body_from_imu(self, arg: Sequence[float], /) -> None: ...

class InformationFactorBatch(FactorBatch):
    """
    Wraps any factor batch and applies per-factor sqrt-information matrices.

    Residuals and Jacobians are left-multiplied by the corresponding
    square-root information matrix: r' = Omega^{1/2} r, J' = Omega^{1/2} J.

    Parameters
    ----------
    inner_factor : FactorBatch
        The factor batch to wrap.
    sqrt_information_matrices : DevicePointer
        Device buffer with one square-root information matrix per inner factor
        (``inner_factor.capacity`` matrices), each residual_size x residual_size,
        stored contiguously in row-major order.

    InformationFactorBatch (factor)
      residual: L_f * r_inner
      sqrt_information_matrices: residual_size^2 floats per factor (row-major)
      relative: no
      use: Weight any factor by a per-factor square-root information matrix (measurement covariance^-1/2).
      notes: Inherits the wrapped factor's states.
      capacity: how many factors (or states) the arrays hold. Batches start with 0 active items: call set_num_active_factors(n) / set_num_active_states(n) before solving. Arrays are float32 GPU arrays (CuPy), C-contiguous.
    """

    def __init__(self, inner_factor: FactorBatch, sqrt_information_matrices: object) -> None: ...

    @property
    def inner_factor(self) -> FactorBatch:
        """The wrapped factor batch."""

class JacobianMode(enum.Enum):
    """
    Selects how a factor batch's Jacobian is obtained: analytic (the factor's own hand-derived Evaluate() output) or numeric (finite differences on the manifold tangent space of each referenced state block, via Problem.add_factor_batch's jacobian_mode_override or MinimizerOptions.jacobian_mode).
    """

    analytic = 0
    """The factor's own hand-derived Jacobians from Evaluate() (default)."""

    numeric = 1
    """Finite differences on the tangent space of each referenced state."""

class LevenbergMarquardtMinimizer(Minimizer):
    """
    Levenberg-Marquardt: Gauss-Newton with an adaptive damping per subproblem; the robust default. Construct with options: LevenbergMarquardtMinimizerOptions (its base_options holds the common MinimizerOptions).
    """

    def __init__(self, options: LevenbergMarquardtMinimizerOptions = ...) -> None: ...

class LevenbergMarquardtMinimizerOptions:
    """Options for the Levenberg-Marquardt minimizer."""

    def __init__(self) -> None: ...

    @property
    def base_options(self) -> MinimizerOptions:
        """
        Options common to all minimizers (MinimizerOptions). Set fields on it, e.g. options.base_options.max_num_iterations = 100.
        """

    @base_options.setter
    def base_options(self, arg: MinimizerOptions, /) -> None: ...

    @property
    def initial_lambda(self) -> float:
        """
        Initial damping lambda; larger is more conservative (closer to gradient descent). 0 (Gauss-Newton steps) is allowed. Default: 1e-3.
        """

    @initial_lambda.setter
    def initial_lambda(self, arg: float, /) -> None: ...

    @property
    def relative_reduction_tolerance(self) -> float:
        """
        Converged when the cost reduction the linear model predicts, relative to the cost, falls below this. Default: 1e-6.
        """

    @relative_reduction_tolerance.setter
    def relative_reduction_tolerance(self, arg: float, /) -> None: ...

    @property
    def lambda_upscale(self) -> float:
        """
        Damping growth on a rejected step (> 1); the k-th rejection in a row multiplies lambda by lambda_upscale * 2^(k-1). Default: 2.
        """

    @lambda_upscale.setter
    def lambda_upscale(self, arg: float, /) -> None: ...

    @property
    def lambda_downscale(self) -> float:
        """
        Damping factor on a very successful step (rho > lambda_downscale_threshold). Default: 0.5.
        """

    @lambda_downscale.setter
    def lambda_downscale(self, arg: float, /) -> None: ...

    @property
    def lambda_max(self) -> float:
        """Largest damping (>= lambda_min). Default: 1e6."""

    @lambda_max.setter
    def lambda_max(self, arg: float, /) -> None: ...

    @property
    def lambda_min(self) -> float:
        """Smallest damping (> 0). Default: 1e-6."""

    @lambda_min.setter
    def lambda_min(self, arg: float, /) -> None: ...

    @property
    def min_diagonal(self) -> float:
        """
        Floor of the diagonal the damping scales, lambda * max(diag(H), min_diagonal), so unobservable unknowns (zero Jacobian columns) get a zero step instead of a singular system. Default: 1e-6.
        """

    @min_diagonal.setter
    def min_diagonal(self, arg: float, /) -> None: ...

    @property
    def step_accept_threshold(self) -> float:
        """
        Accept a step when rho = actual / predicted cost reduction >= this. Default: 0.25.
        """

    @step_accept_threshold.setter
    def step_accept_threshold(self, arg: float, /) -> None: ...

    @property
    def lambda_downscale_threshold(self) -> float:
        """Lower the damping when rho > this. Default: 0.75."""

    @lambda_downscale_threshold.setter
    def lambda_downscale_threshold(self, arg: float, /) -> None: ...

class LinearSystemType(enum.Enum):
    """
    How each iteration's linear system is formed (MinimizerOptions.linear_system).
    """

    Assembled = 0
    """The full normal equations, solved with sparse_linear_solver_type."""

    SchurComplement = 1
    """
    Eliminate the state batches of Problem.set_eliminated_state_batches (the landmarks of a bundle adjustment) and solve the reduced system with the built-in supernodal Cholesky (BlockSparseCholesky; sparse_linear_solver_type is not used).
    """

class LossFunctionBatch:
    """Abstract base class for batched robust loss functions."""

    def evaluate(self, s: object, out: object, count: int, stream: CudaStream) -> None:
        r"""
        Evaluates the loss on `count` squared residual norms s (float32 GPU array; may be overwritten) into out (float32 GPU array of count x 3: rho, rho', rho\'\' per entry), asynchronously on `stream`. The cost of a factor is 0.5 * rho(|r|^2).
        """

class Minimizer:
    """
    Common base of GaussNewtonMinimizer and LevenbergMarquardtMinimizer. Not constructible; accepts either (e.g. AugmentedLagrangianMinimizer's inner minimizer).
    """

    def minimize(self, stream: CudaStream, problem: Problem) -> MinimizerSummary:
        """
        Minimize the problem's cost from its current states; the states are updated in place. Returns a MinimizerSummary.
        """

    def subproblem_termination_reasons(self) -> Annotated[ArrayLike, dict(dtype='int32', shape=(None))]:
        """
        The last minimize() call's TerminationReason value of every subproblem (Problem.set_problem_partition), as a numpy int array: e.g. np.flatnonzero(r >= int(TerminationReason.MaxIterations)) lists the subproblems that did not converge.
        """

    @property
    def options(self) -> MinimizerOptions:
        """
        Options the minimizer runs with (a copy; for Levenberg-Marquardt the base options with max_consecutive_rejected_steps widened by the damping's escalation room).
        """

class MinimizerOptions:
    """
    Options common to GaussNewtonMinimizer and LevenbergMarquardtMinimizer.
    """

    def __init__(self) -> None: ...

    @property
    def max_num_iterations(self) -> int:
        """Maximum iterations of one minimize() call. Default: 50."""

    @max_num_iterations.setter
    def max_num_iterations(self, arg: int, /) -> None: ...

    @property
    def state_tolerance(self) -> float:
        """
        Converged when the squared step norm |dx|^2 falls below this (absolute, tangent units). Default: 1e-6.
        """

    @state_tolerance.setter
    def state_tolerance(self, arg: float, /) -> None: ...

    @property
    def cost_tolerance(self) -> float:
        """
        Converged when the cost falls below this (absolute). Lower it when the final cost is tiny (exact data, small residual units). Default: 1e-6.
        """

    @cost_tolerance.setter
    def cost_tolerance(self, arg: float, /) -> None: ...

    @property
    def max_consecutive_rejected_steps(self) -> int:
        """
        Stop a subproblem after this many rejected steps in a row (Levenberg-Marquardt: at full damping); 0 disables. Default: 5.
        """

    @max_consecutive_rejected_steps.setter
    def max_consecutive_rejected_steps(self, arg: int, /) -> None: ...

    @property
    def max_line_search_steps(self) -> int:
        """
        Backtracking line search: a step that does not decrease the cost is halved along the same direction up to this many times; the first shorter step that decreases the cost is taken (any decreasing step is taken, and LM keeps its damping). 0 (default) disables it.
        """

    @max_line_search_steps.setter
    def max_line_search_steps(self, arg: int, /) -> None: ...

    @property
    def reuse_structure(self) -> bool:
        """
        The problem's structure is unchanged since this minimizer's previous minimize() on it (same batches, connectivity, active/constant counts, partition): later calls skip the structure setup. A size change falls back to the full setup. Default: False.
        """

    @reuse_structure.setter
    def reuse_structure(self, arg: bool, /) -> None: ...

    @property
    def sparse_linear_solver_type(self) -> SparseLinearSolverType:
        """
        Linear solver of each step (SparseLinearSolverType). Default: BlockSparseCholesky (exact, no dependencies); BlockSparsePCG for graphs with many long-range edges; cuDSS optional; dense solvers for small dense problems.
        """

    @sparse_linear_solver_type.setter
    def sparse_linear_solver_type(self, arg: SparseLinearSolverType, /) -> None: ...

    @property
    def linear_system(self) -> LinearSystemType:
        """
        How each iteration's linear system is formed: LinearSystemType.Assembled (default) or SchurComplement (needs Problem.set_eliminated_state_batches).
        """

    @linear_system.setter
    def linear_system(self, arg: LinearSystemType, /) -> None: ...

    @property
    def column_scaling(self) -> ColumnScaling:
        """
        Diagonal scaling of the normal equations (ColumnScaling): hessian_diagonal helps when parameters have very different scales. Default: none.
        """

    @column_scaling.setter
    def column_scaling(self, arg: ColumnScaling, /) -> None: ...

    @property
    def jacobian_mode(self) -> JacobianMode:
        """
        Global default JacobianMode for every factor batch, unless overridden per group via Problem.add_factor_batch's jacobian_mode_override. Default: JacobianMode.analytic.
        """

    @jacobian_mode.setter
    def jacobian_mode(self, arg: JacobianMode, /) -> None: ...

    @property
    def numeric_diff_options(self) -> NumericDiffOptions:
        """
        Tuning knobs used whenever a factor batch is evaluated with JacobianMode.numeric; ignored otherwise.
        """

    @numeric_diff_options.setter
    def numeric_diff_options(self, arg: NumericDiffOptions, /) -> None: ...

    @property
    def disable_safety_checks(self) -> bool:
        """
        When False, the linear solvers check their factorization (BlockSparseCholesky and Schur pivot flags, cuSOLVER devInfo, QR rank, LDLT pivots; one read-back each). A failed solve is then a rejected step for Levenberg-Marquardt (more damping) and a RuntimeError for Gauss-Newton. When True (default) these checks are skipped for speed: a singular system can give a non-finite step, which is rejected (summary reason NonFiniteStep). Default: True.
        """

    @disable_safety_checks.setter
    def disable_safety_checks(self, arg: bool, /) -> None: ...

class MinimizerSummary:
    """
    Result of Minimizer.minimize(): iterations, costs, why the solve stopped (termination_reason, message) and the wall time. Check converged() first; message says what went wrong and what to try. to_dict() gives a JSON-ready dict, report() a multi-line text.
    """

    def to_dict(self) -> dict:
        """All fields as a JSON-ready dict (enums as names, NaN as None) plus ``converged``."""

    def report(self) -> str:
        """A short multi-line text: the outcome and message first, then the numbers."""

    @property
    def num_iterations(self) -> int:
        """Iterations performed (each builds and solves one linear system)."""

    @property
    def initial_cost(self) -> float:
        """Total cost 1/2 sum rho(|r|^2) of the states passed in."""

    @property
    def final_cost(self) -> float:
        """Total cost of the states written back to the problem."""

    @property
    def iteration_costs(self) -> list[float]:
        """Total cost at the start of each iteration."""

    @property
    def termination_reason(self) -> TerminationReason:
        """
        TerminationReason: why the solve stopped (with a partition, the most severe reason of any subproblem).
        """

    @property
    def num_problems_by_reason(self) -> list[int]:
        """
        Number of subproblems per TerminationReason value (index = int(reason)); empty for real-time solves.
        """

    @property
    def message(self) -> str:
        """
        Why the solve stopped and, when it did not converge, the likely causes and what to try.
        """

    @property
    def num_free_parameters(self) -> int:
        """Number of free (optimized) tangent-space parameters."""

    @property
    def solve_time_ms(self) -> float:
        """Wall time of the minimize() call in milliseconds."""

    def converged(self) -> bool:
        """
        True when every subproblem stopped at a convergence criterion (or had nothing to optimize); False at the iteration cap, after repeated rejected steps, or with a non-finite cost.
        """

    def __repr__(self) -> str: ...

class NumericDiffMethod(enum.Enum):
