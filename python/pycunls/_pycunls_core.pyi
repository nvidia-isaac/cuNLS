class TerminationReason(enum.IntEnum):
    """
    Why a minimizer stopped iterating a (sub)problem, ordered by severity. Convergence: CostTolerance, StateTolerance, RelativeReductionTolerance (Levenberg-Marquardt), NoCostDecrease (Gauss-Newton: a step no longer lowered the cost). Not converged: MaxIterations, MaxRejectedSteps, NonFiniteStep (a failed linear solve or NaN at the trial states), NonFiniteCost (NaN/Inf initial cost). Also NoFreeStates (all states constant) and NotDetermined (real-time solves).
    """

    NotDetermined = 0
    """Real-time (fixed-iteration) solve: not read back."""

    NoFreeStates = 1
    """Every state is constant: nothing to optimize."""

    CostTolerance = 2
    """Converged: the cost fell below cost_tolerance."""

    StateTolerance = 3
    """Converged: the squared step norm fell below state_tolerance."""

    RelativeReductionTolerance = 4
    """
    Converged (Levenberg-Marquardt): the predicted relative cost reduction fell below relative_reduction_tolerance.
    """

    NoCostDecrease = 5
    """Converged (Gauss-Newton): a full step no longer lowered the cost."""

    MaxIterations = 6
    """Not converged: max_num_iterations was reached."""

    MaxRejectedSteps = 7
    """
    Not converged: max_consecutive_rejected_steps steps were rejected in a row.
    """

    NonFiniteStep = 8
    """
    Not converged: the last trial steps were not finite (a failed linear solve or NaN at the trial states).
    """

    NonFiniteCost = 9
    """Not started: the initial cost is NaN or infinite."""

