class ConstraintFactorBatch(ConstraintFactorBatchBase):
    """
    Turns any factor batch into constraint rows: every residual row r of the wrapped batch becomes scale * r(x) = 0 (Equality) or scale * r(x) <= 0 (Inequality).

    Parameters
    ----------
    inner_factor : FactorBatch
        The factor batch whose residuals are the constraint rows.
    kind : ConstraintKind
        Equality or Inequality.
    scale : float
        Positive row scale, so that the constraint tolerance means the same in meters,
        radians or newtons.

    ConstraintFactorBatch (factor)
      residual: scale * r_inner = 0 or <= 0
      relative: no
      use: Turn any factor into hard equality / inequality constraints (AugmentedLagrangianMinimizer).
      capacity: how many factors (or states) the arrays hold. Batches start with 0 active items: call set_num_active_factors(n) / set_num_active_states(n) before solving. Arrays are float32 GPU arrays (CuPy), C-contiguous.
    """

    def __init__(self, inner_factor: FactorBatch, kind: ConstraintKind, scale: float = 1.0) -> None: ...

    @property
    def inner_factor(self) -> FactorBatch:
        """The wrapped factor batch whose residuals are the constraint rows."""

class ConstraintFactorBatchBase(FactorBatch):
    """
    A factor batch whose rows are constraints. Evaluates the augmented Lagrangian residuals of its multipliers (one per row) and penalties (one per factor); AugmentedLagrangianMinimizer updates both.
    """

    @property
    def kind(self) -> ConstraintKind:
        """ConstraintKind of the rows: Equality (r = 0) or Inequality (r <= 0)."""

    @property
    def scale(self) -> float:
        """Scale applied to the constraint rows."""

    @property
    def multipliers_ptr(self) -> int:
        """
        Device pointer to capacity * residuals_size float multipliers (row r of factor f at f * residuals_size + r).
        """

    @property
    def penalties_ptr(self) -> int:
        """Device pointer to capacity float penalties, one per factor."""

    def reset_multipliers(self, stream: CudaStream) -> None:
        """Sets every multiplier to 0."""

    def set_penalty(self, penalty: float, stream: CudaStream) -> None:
        """Sets the penalty of every factor."""

class ConstraintKind(enum.Enum):
    """Kind of a constraint row."""

    Equality = 0
    """c(x) = 0"""

    Inequality = 1
    """c(x) <= 0"""

class CudaStream:
    """
    A CUDA stream for cuNLS work (created on construction, destroyed with the object). sync_on_destroy: synchronize before destroying. minimize() synchronizes it before returning; use cupy.cuda.Stream.from_external(stream) to order CuPy work with it.
    """

    def __init__(self, sync_on_destroy: bool = False) -> None: ...

    def get_stream(self) -> int:
        """Returns the underlying cudaStream_t as an integer handle."""

    def __cuda_stream__(self) -> tuple:
        """
        CUDA stream protocol (version 0, handle): cupy.cuda.Stream.from_external(stream) and other libraries can enqueue work on this stream.
        """

class CustomFactorBatch(FactorBatch):
    """
    Base class for user-defined factors. Override evaluate() in Python. Constructor: residual_size (residual dimension per factor), state_sizes (tangent size of each connected state, in connection order), capacity (factors the measurement buffers hold). For model fitting prefer pycunls.fit; for Warp kernels pycunls.warp.WarpFactorBatch.
    """

    def __init__(self, residual_size: int, state_sizes: Sequence[int], capacity: int) -> None: ...

    def evaluate(self, residuals_ptr: int, jacobians_ptr: int, state_pointers_ptr: int, stream_handle: int, factor_ids_ptr: int, num_factor_ids: int) -> bool:
        """
        Override in a subclass. Evaluate n = num_factor_ids items (or num_active_factors when 0): item t is factor factor_ids[t] (or t when factor_ids_ptr is 0) at the states state_pointers[t * B + b] (B = len(state_sizes)). Write residuals[t * m + r] and, when jacobians_ptr is not 0, jacobians[(t * m + r) * J + c] (J = sum(state_sizes), derivative with respect to the tangent-space step). All pointers are ints; enqueue on stream_handle and return True. For one-call model fitting use pycunls.fit; check a custom Jacobian with pycunls.check_jacobians.
        """

class CustomStateBatch(StateBatch):
    """
    Base class for user-defined state batches. Override plus() in Python.

    The plus() method implements the manifold retraction:
      x_plus_delta = x (+) delta
    All pointers are passed as integer handles.

    Constructor: data (float32 GPU array of capacity x ambient_size), ambient_size (floats stored per state), tangent_size (degrees of freedom), capacity (states the array holds), and optionally const_state_ids (int32 GPU array) with const_capacity (entries it holds).
    """

    @overload
    def __init__(self, data: object, ambient_size: int, tangent_size: int, capacity: int) -> None: ...

    @overload
    def __init__(self, data: object, ambient_size: int, tangent_size: int, capacity: int, const_state_ids: object, const_capacity: int) -> None: ...

    def plus(self, x_ptr: int, delta_ptr: int, x_plus_delta_ptr: int, stream_handle: int, num_replicas: int) -> None:
        """
        Override in a subclass: x_plus_delta = x (+) delta for num_replicas x num_active_states states (int device pointers; enqueue on stream_handle). See pycunls.warp.WarpStateBatch for a Warp-based base class.
        """

class FactorBatch:
    """Abstract base class for batched factors."""

    @property
    def capacity(self) -> int:
        """Factors the measurement buffers hold (the constructor's capacity)."""

    def set_num_active_factors(self, num_active_factors: int) -> None:
        """
        Sets the active factor count (the first num_active_factors measurements are used). Factor batches start with 0 active factors: call this before the first solve, and again whenever the size changes. Host-only; takes effect at the next minimize(). Raises ValueError above the capacity.
        """

    @property
    def num_active_factors(self) -> int:
        """Active factor count (set_num_active_factors)."""

    @property
    def residuals_size(self) -> int:
        """Residual dimension of one factor."""

    def state_sizes(self) -> list[int]:
        """
        Tangent size of each state slot the factor reads (one entry per connected state).
        """

    def evaluate_batch(self, residuals: object, jacobians: object | None, state_pointer_table: object, stream: CudaStream) -> bool:
        """
        Evaluates the active factors at the states the table points to (asynchronous on stream). residuals: float32 device array of num_active_factors x residuals_size; jacobians: None or float32 device array of num_active_factors x residuals_size x sum(state_sizes()) (row-major per factor, the state slots side by side); state_pointer_table: uint64 device array, entry f * B + b is the state slot b of factor f (Problem.host_state_pointers gives the problem's). Returns False if the batch reports a failure. Used by pycunls.evaluate and pycunls.check_jacobians.
        """

