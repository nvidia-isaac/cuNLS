# Default CMAKE_CUDA_ARCHITECTURES, included before project() (a caller's choice wins).
#
# Native code (SASS) for every GPU generation the CUDA toolkit supports, so no supported GPU
# compiles PTX at load time (a slow first start and code not tuned for the GPU). PTX is kept only
# for the newest architecture, for GPUs newer than the toolkit.
#   all toolkits:      75 (Turing), 80 (A100), 86 (RTX 30 / A-series), 89 (Ada), 90 (Hopper)
#   CUDA 12.8 and up:  100 (B200 / GB200), 120 (RTX 50 / RTX PRO Blackwell, also runs on 121)
#   aarch64 hosts:     87 (Jetson Orin, CUDA 12) or 110 (Jetson Thor, CUDA 13)
if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
  set(_cunls_nvcc "${CMAKE_CUDA_COMPILER}")
  if(NOT _cunls_nvcc AND DEFINED ENV{CUDACXX})
    set(_cunls_nvcc "$ENV{CUDACXX}")
  endif()
  if(NOT _cunls_nvcc)
    find_program(_cunls_nvcc nvcc)
  endif()
  set(_cunls_cuda_version 0)
  if(_cunls_nvcc)
    execute_process(COMMAND "${_cunls_nvcc}" --version OUTPUT_VARIABLE _cunls_nvcc_output
                    ERROR_QUIET)
    if(_cunls_nvcc_output MATCHES "release ([0-9]+\\.[0-9]+)")
      set(_cunls_cuda_version "${CMAKE_MATCH_1}")
    endif()
  endif()
  set(_cunls_archs 75 80 86 89 90)
  if(_cunls_cuda_version VERSION_GREATER_EQUAL 12.8)
    list(APPEND _cunls_archs 100 120)
  endif()
  # CMAKE_HOST_SYSTEM_PROCESSOR is set by project(), after this file runs: ask the host.
  cmake_host_system_information(RESULT _cunls_host_processor QUERY OS_PLATFORM)
  if(_cunls_host_processor MATCHES "aarch64|arm64")
    if(_cunls_cuda_version VERSION_GREATER_EQUAL 13.0)
      list(APPEND _cunls_archs 110)
    else()
      list(APPEND _cunls_archs 87)
    endif()
  endif()
  list(SORT _cunls_archs COMPARE NATURAL)
  list(POP_BACK _cunls_archs _cunls_newest)
  list(TRANSFORM _cunls_archs APPEND "-real")
  list(APPEND _cunls_archs ${_cunls_newest})
  set(CMAKE_CUDA_ARCHITECTURES "${_cunls_archs}" CACHE STRING "CUDA architectures to compile")
  message(STATUS "cuNLS: CUDA ${_cunls_cuda_version}, architectures ${CMAKE_CUDA_ARCHITECTURES}")
endif()
